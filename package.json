{
  "name": "M.mode.ify",
  "version": "1.2.0",
  "private": true,
  "description": "Create and m-mode from any clip.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist-macarm": "electron-builder --config ./build/buildarm.json",
    "dist-mac64": "electron-builder --config ./build/buildmac.json",
    "dist-win64": "electron-builder --win --x64 --config ./build/buildwin64.json"
  },
  "keywords": [
    "Electron"
  ],
  "author": "Ben C. Smith, MD, FACEP",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://www.ultrasoundoftheweek.com/m-mode-ify"
  },
  "homepage": "https://www.ultrasoundoftheweek.com/m-mode-ify",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.0.0"
  },
  "directories.bin": "node_modules/.bin/",
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@imagemagick/magick-wasm": "^0.0.40",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "jquery": "^4.0.0"
  },
  "productName": "M.mode.ify"
}
